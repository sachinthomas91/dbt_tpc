# dbt profiles can contain warehouse credentials
profiles.yml
.dbt/

# Python environment
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets and local settings
.env
.envrc
*.pem
*.key

# Local databases (e.g. dbt-duckdb, dbt-sqlite)
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# Testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
dbt_internal_packages/
